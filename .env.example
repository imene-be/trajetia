# Copiez ce fichier en .env puis remplissez ce dont vous disposez. Ne publiez JAMAIS le fichier .env.

# --- Obligatoire en production ---
NODE_ENV=production
JWT_SECRET=            # 32 caractères aléatoires minimum, par exemple : openssl rand -hex 32
ALLOWED_ORIGINS=https://votre-domaine.fr
TRUST_PROXY=1          # 1 si l'hébergeur place un proxy HTTPS devant le serveur

# --- Base de données (fichier SQLite : prévoir un disque persistant) ---
DB_PATH=/data/trajetia.db

# --- FACULTATIF. Sans rien, l'application utilise les données ouvertes Ilévia (Lille), réelles et sans clé.
# --- Navitia ajoute la SNCF et d'autres réseaux : jeton gratuit sur https://navitia.io ---
NAVITIA_TOKEN=
NAVITIA_COVERAGE=sncf  # région Navitia à utiliser (à vérifier avec votre jeton)

# --- IA de recommandation (comme dans l'architecture : elle compare des itinéraires, sans donnée personnelle) ---
# Sans rien ci-dessous : recommandation AUTOMATIQUE par règles (gratuite), annoncée comme telle dans l'application.
#
# OPTION GRATUITE A (RECOMMANDÉE, la plus rapide) : Groq, clé gratuite sans carte bancaire : https://console.groq.com
# TESTÉ : 250 à 310 ms, réponses valides ; limites gratuites annoncées : 1000 requêtes par jour, 8000 jetons par minute.
# (llama-3.1-8b-instant n'existe plus ; les modèles « gpt-oss » donnent des réponses vides ici ; qwen/qwen3.8-27b fonctionne)
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=qwen/qwen3.8-27b
# AI_API_KEY=
#
# OPTION GRATUITE B : Google Gemini (offre gratuite, mais LENTE ET LIMITÉE : 20 requêtes/jour par modèle, 0,5 s le matin mais 15 à 25 s ensuite) : https://aistudio.google.com
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-2.5-flash-lite   # plusieurs modèles séparés par des virgules : le gratuit limite à ~20 requêtes/jour PAR modèle (erreur 429), on passe au suivant. TESTÉ : 0,5 à 1,2 s. (gemini-2.5-flash : réponses refusées par le contrôle ; gemini-3.1-flash-lite : parfois plus de 3 s)
# AI_API_KEY=
#
# OPTION GRATUITE C : Ollama, un modèle qui tourne sur votre ordinateur (https://ollama.com, puis `ollama pull llama3.2`)
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.2
# (pas de clé ; sur un ordinateur portable la réponse peut dépasser 3 s : alors le plan B s'affiche, ou augmentez AI_TIMEOUT_MS)
#
# OPTION PAYANTE : API Claude (https://console.anthropic.com), payante à l'usage
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5
AI_TIMEOUT_MS=3000          # délai maximum de l'architecture ; au-delà : alternatives classées par heure d'arrivée

# --- Notifications push : `npm run vapid` génère ces clés (gratuit) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:votre-adresse@exemple.fr

# --- Tableau de bord des indicateurs (North Star + 3 KPI) : GET /api/admin/kpis avec l'en-tête X-Admin-Token ---
ADMIN_TOKEN=

# --- Tests seulement : données fictives (ne pas utiliser en production) ---
# DEMO_DATA=true
